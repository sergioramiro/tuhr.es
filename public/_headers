# Block Netlify HUD script/banner
/.netlify/scripts/hud*
  X-Robots-Tag: noindex
  Cache-Control: public, max-age=0, must-revalidate

# Cache static assets
/fonts.googleapis.com/*
  Cache-Control: public, max-age=31536000, immutable

/fonts.gstatic.com/*
  Cache-Control: public, max-age=31536000, immutable

/*.woff2
  Cache-Control: public, max-age=31536000, immutable

/*.svg
  Cache-Control: public, max-age=86400

/*.png
  Cache-Control: public, max-age=86400

/*.ico
  Cache-Control: public, max-age=86400
