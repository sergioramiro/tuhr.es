---
import GuideLayout from '../../../layouts/GuideLayout.astro';
import { marked } from 'marked';
import fs from 'fs';
import path from 'path';

const mdPath = path.join(process.cwd(), 'src/pages/guias/todo-sobre-tu-finiquito/_content.md');
const md = fs.readFileSync(mdPath, 'utf8');
const htmlContent = marked.parse(md);
---

<GuideLayout
  title="Todo sobre tu finiquito | tuhr.es"
  description="Guía completa sobre el finiquito laboral en España: qué es, cómo calcularlo, qué incluir, tus derechos ante un despido y los errores más comunes que debes evitar."
  ogImage="https://tuhr.es/images/og-finiquito.jpg"
>
  <Fragment>
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Qué es el finiquito?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "El finiquito es la cantidad económica que la empresa abona al trabajador al finalizar la relación laboral. Su objetivo es compensar al empleado por cualquier derecho pendiente de cobro generado durante su tiempo en la empresa, incluyendo salarios, vacaciones y pagas extras pendientes."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cuál es la diferencia entre finiquito e indemnización?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "El finiquito es el pago de salarios, vacaciones y pagas extras pendientes y se cobra siempre, sea cual sea la causa de la extinción. La indemnización es una compensación económica adicional que solo se paga en determinados tipos de despido (objetivo, improcedente) y en la extinción de contratos temporales. No se cobra en una dimisión o en un despido disciplinario procedente."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué conceptos incluye el finiquito?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "El finiquito incluye: salario del mes en curso proporcional a los días trabajados, parte proporcional de las pagas extraordinarias no cobradas, vacaciones no disfrutadas, comisiones o bonificaciones pendientes, horas extra no cobradas, salarios atrasados y dietas o gastos de viaje no abonados."
          }
        },
        {
          "@type": "Question",
          "name": "¿Se aplica retención de IRPF al finiquito?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí, el finiquito está sujeto a retención del IRPF igual que un salario normal. La retención se aplica sobre el total del finiquito. Sin embargo, las indemnizaciones por despido improcedente y otras indemnizaciones legales pueden estar exentas de tributación hasta ciertos límites."
          }
        },
        {
          "@type": "Question",
          "name": "¿En cuánto tiempo tiene que pagar la empresa el finiquito?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "La empresa está obligada a abonar el finiquito en el momento mismo de la extinción del contrato, normalmente el mismo día o al día siguiente hábil. Si la empresa no paga en plazo, el trabajador puede presentar una papeleta de conciliación ante el SMAC."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué hacer si el finiquito es incorrecto o insuficiente?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Si consideras que tu finiquito es incorrecto, primero intenta negociar con la empresa enviando un escrito detallado con los errores detectados. Si no hay respuesta, presenta una papeleta de conciliación ante el SMAC de tu comunidad autónoma dentro de los 20 días hábiles siguientes a la extinción. Si la conciliación fracasa, puedes interponer una demanda ante el Juzgado de lo Social."
          }
        }
      ]
    }
    </script>
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "HowTo",
      "name": "Cómo calcular tu finiquito paso a paso",
      "description": "Proceso para calcular el finiquito laboral incluyendo salario del mes en curso, pagas extraordinarias, vacaciones no disfrutadas y horas extra pendientes.",
      "totalTime": "PT30M",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Calcular el salario del mes en curso",
          "text": "Calcula los días trabajados desde el inicio del mes hasta la fecha de extinción del contrato. Multiplica el salario mensual por los días trabajados y divide entre los días del mes. Ejemplo: si tu salario es 1.800 € y trabajaste 15 días de un mes de 31: 1.800 × 15 / 31 = 871,00 €."
        },
        {
          "@type": "HowToStep",
          "name": "Calcular la parte proporcional de pagas extraordinarias",
          "text": "Determina los días trabajados en el año actual hasta la fecha de extinción. Calcula el total de pagas extraordinarias anuales y aplica la proporción. Ejemplo: con dos pagas extras de 1.800 € y 288 días trabajados: (1.800 × 2) × 288 / 365 = 2.839,45 €."
        },
        {
          "@type": "HowToStep",
          "name": "Calcular las vacaciones no disfrutadas",
          "text": "Calcula los días de vacaciones que te corresponden según los días trabajados en el año (días trabajados × 30 / 365). Resta los días que ya disfrutaste. Multiplica los días pendientes por el salario diario. Ejemplo: 23,6 días correspondientes − 15 disfrutados = 8,6 días pendientes × (1.800 / 30) = 516,00 €."
        },
        {
          "@type": "HowToStep",
          "name": "Sumar las horas extra pendientes",
          "text": "Identifica las horas extra no cobradas y multiplícalas por el salario horario con el recargo correspondiente (25% en jornada ordinaria). Ejemplo: 20 horas × 18 € = 360,00 €."
        },
        {
          "@type": "HowToStep",
          "name": "Sumar todos los conceptos para obtener el total",
          "text": "Suma el salario del mes en curso, la parte proporcional de pagas extras, las vacaciones no disfrutadas, las horas extra pendientes y cualquier otro concepto adeudado (dietas, bonus, comisiones). Este total es tu finiquito bruto."
        },
        {
          "@type": "HowToStep",
          "name": "Revisar y verificar los cálculos",
          "text": "Comprueba cada concepto antes de firmar el finiquito. Verifica que los días, porcentajes y cantidades son correctos. Si tienes dudas, firma con la reserva 'no conforme' y reclama por escrito a la empresa."
        }
      ]
    }
    </script>
  </Fragment>
  <main class="pt-16">
    <div class="max-w-[72rem] mx-auto px-gutter-desktop py-space-md">
      <nav class="text-body-sm text-on-surface/60">
        <a href="/" class="hover:text-primary transition-colors no-underline">Inicio</a>
        <span class="mx-space-sm">›</span>
        <a href="/guias/" class="hover:text-primary transition-colors no-underline">Guías</a>
        <span class="mx-space-sm">›</span>
        <span class="text-on-surface">Todo sobre tu finiquito </span>
      </nav>
    </div>
    <article class="max-w-[56rem] mx-auto px-gutter-desktop pb-space-3xl">
      <header class="mb-space-2xl">
        <h1 class="font-headline text-headline-xl font-extrabold text-on-surface">Todo sobre tu finiquito </h1>
        <p class="mt-space-md text-body-lg text-on-surface/60">Publicado en tuhr.es · Guía actualizada 2026</p>
      </header>

      <!-- Diagrama: Componentes del finiquito -->
      <div class="mb-space-2xl p-space-lg bg-surface-container-low rounded-xl border border-outline/10">
        <svg viewBox="0 0 800 400" class="w-full h-auto" xmlns="http://www.w3.org/2000/svg">
          <!-- Título -->
          <text x="400" y="35" text-anchor="middle" font-size="20" font-weight="bold" fill="#1a1a1a">¿Qué incluye tu finiquito?</text>

          <!-- Caja principal: Finiquito -->
          <rect x="300" y="60" width="200" height="50" rx="8" fill="#0e7c46"/>
          <text x="400" y="90" text-anchor="middle" font-size="16" font-weight="bold" fill="white">FINIQUITO</text>

          <!-- Líneas de conexión -->
          <line x1="400" y1="110" x2="400" y2="140" stroke="#0e7c46" stroke-width="2"/>

          <!-- Rama izquierda: Salario mes -->
          <line x1="400" y1="140" x2="120" y2="140" stroke="#0e7c46" stroke-width="2"/>
          <line x1="120" y1="140" x2="120" y2="160" stroke="#0e7c46" stroke-width="2"/>
          <rect x="20" y="160" width="200" height="80" rx="8" fill="#e8f5e9" stroke="#0e7c46" stroke-width="1"/>
          <text x="120" y="185" text-anchor="middle" font-size="13" font-weight="bold" fill="#0e7c46">Salario del mes en curso</text>
          <text x="120" y="205" text-anchor="middle" font-size="11" fill="#555">Días trabajados × salario diario</text>
          <text x="120" y="225" text-anchor="middle" font-size="11" fill="#0e7c46" font-weight="bold">Ej: 1.800€ × 15/31 = 871€</text>

          <!-- Rama centro-izq: Pagas extras -->
          <line x1="400" y1="140" x2="300" y2="140" stroke="#0e7c46" stroke-width="2"/>
          <line x1="300" y1="140" x2="300" y2="160" stroke="#0e7c46" stroke-width="2"/>
          <rect x="200" y="160" width="200" height="80" rx="8" fill="#e8f5e9" stroke="#0e7c46" stroke-width="1"/>
          <text x="300" y="185" text-anchor="middle" font-size="13" font-weight="bold" fill="#0e7c46">Pagas extras pendientes</text>
          <text x="300" y="205" text-anchor="middle" font-size="11" fill="#555">Parte proporcional no cobrada</text>
          <text x="300" y="225" text-anchor="middle" font-size="11" fill="#0e7c46" font-weight="bold">Ej: 3.600€ × 288/365 = 2.839€</text>

          <!-- Rama centro-der: Vacaciones -->
          <line x1="400" y1="140" x2="500" y2="140" stroke="#0e7c46" stroke-width="2"/>
          <line x1="500" y1="140" x2="500" y2="160" stroke="#0e7c46" stroke-width="2"/>
          <rect x="400" y="160" width="200" height="80" rx="8" fill="#e8f5e9" stroke="#0e7c46" stroke-width="1"/>
          <text x="500" y="185" text-anchor="middle" font-size="13" font-weight="bold" fill="#0e7c46">Vacaciones no disfrutadas</text>
          <text x="500" y="205" text-anchor="middle" font-size="11" fill="#555">Días pendientes × salario diario</text>
          <text x="500" y="225" text-anchor="middle" font-size="11" fill="#0e7c46" font-weight="bold">Ej: 8,6 días = 516€</text>

          <!-- Rama derecha: Horas extra -->
          <line x1="400" y1="140" x2="680" y2="140" stroke="#0e7c46" stroke-width="2"/>
          <line x1="680" y1="140" x2="680" y2="160" stroke="#0e7c46" stroke-width="2"/>
          <rect x="580" y="160" width="200" height="80" rx="8" fill="#e8f5e9" stroke="#0e7c46" stroke-width="1"/>
          <text x="680" y="185" text-anchor="middle" font-size="13" font-weight="bold" fill="#0e7c46">Horas extra pendientes</text>
          <text x="680" y="205" text-anchor="middle" font-size="11" fill="#555">Horas no cobradas</text>
          <text x="680" y="225" text-anchor="middle" font-size="11" fill="#0e7c46" font-weight="bold">Ej: 20h × 18€ = 360€</text>

          <!-- Total -->
          <line x1="400" y1="240" x2="400" y2="270" stroke="#0e7c46" stroke-width="2"/>
          <rect x="250" y="270" width="300" height="60" rx="8" fill="#0e7c46"/>
          <text x="400" y="295" text-anchor="middle" font-size="14" font-weight="bold" fill="white">TOTAL FINIQUITO</text>
          <text x="400" y="315" text-anchor="middle" font-size="18" font-weight="bold" fill="white">4.586,45€ brutos</text>

          <!-- Nota -->
          <text x="400" y="370" text-anchor="middle" font-size="12" fill="#888">* Ejemplo orientativo. Usa nuestra calculadora para tu caso particular</text>
        </svg>
      </div>

      <div class="prose max-w-none text-body-md text-on-surface/80 space-y-space-lg">
        <Fragment set:html={htmlContent} />
      </div>
    </article>
  </main>
</GuideLayout>
