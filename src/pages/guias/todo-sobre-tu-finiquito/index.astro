---
import GuideLayout from '../../../layouts/GuideLayout.astro';
import { marked } from 'marked';
import fs from 'fs';
import path from 'path';

const mdPath = path.join(process.cwd(), 'src/pages/guias/todo-sobre-tu-finiquito/_content.md');
const md = fs.readFileSync(mdPath, 'utf8');
const htmlContent = marked.parse(md);
---

<GuideLayout
  title="Todo sobre tu finiquito | tuhr.es"
  description="Guía completa sobre el finiquito laboral en España: qué es, cómo calcularlo, qué incluir, tus derechos ante un despido y los errores más comunes que debes evitar."
>
  <main class="pt-16">
    <div class="max-w-[72rem] mx-auto px-gutter-desktop py-space-md">
      <nav class="text-body-sm text-on-surface/50">
        <a href="/" class="hover:text-primary transition-colors no-underline">Inicio</a>
        <span class="mx-space-sm">›</span>
        <a href="/guias/" class="hover:text-primary transition-colors no-underline">Guías</a>
        <span class="mx-space-sm">›</span>
        <span class="text-on-surface">Todo sobre tu finiquito </span>
      </nav>
    </div>
    <article class="max-w-[56rem] mx-auto px-gutter-desktop pb-space-3xl">
      <header class="mb-space-2xl">
        <h1 class="font-headline text-headline-xl font-extrabold text-on-surface">Todo sobre tu finiquito </h1>
        <p class="mt-space-md text-body-lg text-on-surface/60">Publicado en tuhr.es · Guía actualizada 2026</p>
      </header>
      <div class="prose max-w-none text-body-md text-on-surface/80 space-y-space-lg">
        <Fragment set:html={htmlContent} />
      </div>
    </article>
  </main>
</GuideLayout>
