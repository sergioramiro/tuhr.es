---
import GuideLayout from '../../../layouts/GuideLayout.astro';
import { marked } from 'marked';
import fs from 'fs';
import path from 'path';

const mdPath = path.join(process.cwd(), 'src/pages/guias/todo-sobre-tu-finiquito/_content.md');
const md = fs.readFileSync(mdPath, 'utf8');
const htmlContent = marked.parse(md);
---

<GuideLayout
  title="Todo sobre tu finiquito | tuhr.es"
  description="Guía completa sobre el finiquito laboral en España: qué es, cómo calcularlo, qué incluir, tus derechos ante un despido y los errores más comunes que debes evitar."
>
  <main class="pt-16">
    <div class="max-w-[72rem] mx-auto px-gutter-desktop py-space-md">
      <nav class="text-body-sm text-on-surface/60">
        <a href="/" class="hover:text-primary transition-colors no-underline">Inicio</a>
        <span class="mx-space-sm">›</span>
        <a href="/guias/" class="hover:text-primary transition-colors no-underline">Guías</a>
        <span class="mx-space-sm">›</span>
        <span class="text-on-surface">Todo sobre tu finiquito </span>
      </nav>
    </div>
    <article class="max-w-[56rem] mx-auto px-gutter-desktop pb-space-3xl">
      <header class="mb-space-2xl">
        <h1 class="font-headline text-headline-xl font-extrabold text-on-surface">Todo sobre tu finiquito </h1>
        <p class="mt-space-md text-body-lg text-on-surface/60">Publicado en tuhr.es · Guía actualizada 2026</p>
      </header>

      <!-- Diagrama: Componentes del finiquito -->
      <div class="mb-space-2xl p-space-lg bg-surface-container-low rounded-xl border border-outline/10">
        <svg viewBox="0 0 800 400" class="w-full h-auto" xmlns="http://www.w3.org/2000/svg">
          <!-- Título -->
          <text x="400" y="35" text-anchor="middle" font-size="20" font-weight="bold" fill="#1a1a1a">¿Qué incluye tu finiquito?</text>

          <!-- Caja principal: Finiquito -->
          <rect x="300" y="60" width="200" height="50" rx="8" fill="#0e7c46"/>
          <text x="400" y="90" text-anchor="middle" font-size="16" font-weight="bold" fill="white">FINIQUITO</text>

          <!-- Líneas de conexión -->
          <line x1="400" y1="110" x2="400" y2="140" stroke="#0e7c46" stroke-width="2"/>

          <!-- Rama izquierda: Salario mes -->
          <line x1="400" y1="140" x2="120" y2="140" stroke="#0e7c46" stroke-width="2"/>
          <line x1="120" y1="140" x2="120" y2="160" stroke="#0e7c46" stroke-width="2"/>
          <rect x="20" y="160" width="200" height="80" rx="8" fill="#e8f5e9" stroke="#0e7c46" stroke-width="1"/>
          <text x="120" y="185" text-anchor="middle" font-size="13" font-weight="bold" fill="#0e7c46">Salario del mes en curso</text>
          <text x="120" y="205" text-anchor="middle" font-size="11" fill="#555">Días trabajados × salario diario</text>
          <text x="120" y="225" text-anchor="middle" font-size="11" fill="#0e7c46" font-weight="bold">Ej: 1.800€ × 15/31 = 871€</text>

          <!-- Rama centro-izq: Pagas extras -->
          <line x1="400" y1="140" x2="300" y2="140" stroke="#0e7c46" stroke-width="2"/>
          <line x1="300" y1="140" x2="300" y2="160" stroke="#0e7c46" stroke-width="2"/>
          <rect x="200" y="160" width="200" height="80" rx="8" fill="#e8f5e9" stroke="#0e7c46" stroke-width="1"/>
          <text x="300" y="185" text-anchor="middle" font-size="13" font-weight="bold" fill="#0e7c46">Pagas extras pendientes</text>
          <text x="300" y="205" text-anchor="middle" font-size="11" fill="#555">Parte proporcional no cobrada</text>
          <text x="300" y="225" text-anchor="middle" font-size="11" fill="#0e7c46" font-weight="bold">Ej: 3.600€ × 288/365 = 2.839€</text>

          <!-- Rama centro-der: Vacaciones -->
          <line x1="400" y1="140" x2="500" y2="140" stroke="#0e7c46" stroke-width="2"/>
          <line x1="500" y1="140" x2="500" y2="160" stroke="#0e7c46" stroke-width="2"/>
          <rect x="400" y="160" width="200" height="80" rx="8" fill="#e8f5e9" stroke="#0e7c46" stroke-width="1"/>
          <text x="500" y="185" text-anchor="middle" font-size="13" font-weight="bold" fill="#0e7c46">Vacaciones no disfrutadas</text>
          <text x="500" y="205" text-anchor="middle" font-size="11" fill="#555">Días pendientes × salario diario</text>
          <text x="500" y="225" text-anchor="middle" font-size="11" fill="#0e7c46" font-weight="bold">Ej: 8,6 días = 516€</text>

          <!-- Rama derecha: Horas extra -->
          <line x1="400" y1="140" x2="680" y2="140" stroke="#0e7c46" stroke-width="2"/>
          <line x1="680" y1="140" x2="680" y2="160" stroke="#0e7c46" stroke-width="2"/>
          <rect x="580" y="160" width="200" height="80" rx="8" fill="#e8f5e9" stroke="#0e7c46" stroke-width="1"/>
          <text x="680" y="185" text-anchor="middle" font-size="13" font-weight="bold" fill="#0e7c46">Horas extra pendientes</text>
          <text x="680" y="205" text-anchor="middle" font-size="11" fill="#555">Horas no cobradas</text>
          <text x="680" y="225" text-anchor="middle" font-size="11" fill="#0e7c46" font-weight="bold">Ej: 20h × 18€ = 360€</text>

          <!-- Total -->
          <line x1="400" y1="240" x2="400" y2="270" stroke="#0e7c46" stroke-width="2"/>
          <rect x="250" y="270" width="300" height="60" rx="8" fill="#0e7c46"/>
          <text x="400" y="295" text-anchor="middle" font-size="14" font-weight="bold" fill="white">TOTAL FINIQUITO</text>
          <text x="400" y="315" text-anchor="middle" font-size="18" font-weight="bold" fill="white">4.586,45€ brutos</text>

          <!-- Nota -->
          <text x="400" y="370" text-anchor="middle" font-size="12" fill="#888">* Ejemplo orientativo. Usa nuestra calculadora para tu caso particular</text>
        </svg>
      </div>

      <div class="prose max-w-none text-body-md text-on-surface/80 space-y-space-lg">
        <Fragment set:html={htmlContent} />
      </div>
    </article>
  </main>
</GuideLayout>
