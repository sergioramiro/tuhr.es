---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Página no encontrada — tuhr.es"
  description="La página que buscas no existe."
>
  <main class="pt-16 flex items-center justify-center min-h-[60vh]">
    <div class="text-center px-gutter-desktop">
      <h1 class="font-headline text-headline-xl font-extrabold text-on-surface">404</h1>
      <p class="mt-space-md text-body-lg text-on-surface/60">La página que buscas no existe o ha sido movida.</p>
      <a href="/" class="mt-space-xl inline-block bg-primary text-on-primary font-semibold px-space-xl py-space-md rounded-button hover:bg-primary-container transition-colors no-underline">
        Volver al inicio
      </a>
    </div>
  </main>
</Layout>
