---
import BlogLayout from '../../../layouts/BlogLayout.astro';
import { marked } from 'marked';
import fs from 'fs';
import path from 'path';

const mdPath = path.join(process.cwd(), 'blog-articles', '03-baja-medica.md');
let md = fs.readFileSync(mdPath, 'utf8');
md = md.replace(/^---[\s\S]*?---/, '').trim();
const htmlContent = marked.parse(md);
---

<BlogLayout
  title="Baja médica: cuánto cobras y qué derechos tienes"
  description="Guía completa sobre la baja por enfermedad en España: cuánto cobras por enfermedad común, accidente laboral y qué derechos conservas."
  category="Derechos"
  date="11 septiembre 2026"
  readTime="10 min"
  cta={{
    title: "¿Te han dado de baja?",
    description: "Calcula cuánto vas a cobrar durante tu baja médica y conoce tus derechos.",
    links: [
      { href: "/calculadoras/nomina/", text: "Simular mi nómina durante la baja", primary: true },
      { href: "/blog/vacaciones-derechos/", text: "Ver tus derechos laborales", primary: false }
    ]
  }}
>
  <Fragment set:html={htmlContent} />
</BlogLayout>
