---
import BlogLayout from '../../../layouts/BlogLayout.astro';
import { marked } from 'marked';
import fs from 'fs';
import path from 'path';

const mdPath = path.join(process.cwd(), 'blog-articles', '04-autonomo-vs-ajena.md');
let md = fs.readFileSync(mdPath, 'utf8');
md = md.replace(/^---[\s\S]*?---/, '').trim();
const htmlContent = marked.parse(md);
---

<BlogLayout
  title="Trabajo autónomo vs cuenta ajena: qué te conviene más en 2026"
  description="Comparativa completa entre ser autónomo y trabajar por cuenta ajena: impuestos, seguridad social, derechos y cuándo te conviene cada opción."
  category="Empleo"
  date="11 septiembre 2026"
  readTime="10 min"
  cta={{
    title: "¿Cuánto ganas realmente?",
    description: "Compara tu nómina actual con lo que ganarías como autónomo con nuestras calculadoras.",
    links: [
      { href: "/calculadoras/nomina/", text: "Calcular mi nómina actual", primary: true },
      { href: "/blog/finiquito-errores/", text: "Errores comunes en finiquitos", primary: false }
    ]
  }}
>
  <Fragment set:html={htmlContent} />
</BlogLayout>
