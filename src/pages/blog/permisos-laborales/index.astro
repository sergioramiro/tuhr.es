---
import BlogLayout from '../../../layouts/BlogLayout.astro';
import { marked } from '../../../lib/marked-config';
import fs from 'fs';
import path from 'path';

const mdPath = path.join(process.cwd(), 'blog-articles', '02-permisos-laborales.md');
let md = fs.readFileSync(mdPath, 'utf8');
md = md.replace(/^---[\s\S]*?---/, '').trim();
const htmlContent = marked.parse(md);
---

<BlogLayout
  title="Permisos laborales retribuidos en España 2026: guía completa"
  description="Todos los permisos retribuidos que te corresponden como trabajador en España: nacimiento, matrimonio, fallecimiento y más."
  category="Derechos"
  date="11 septiembre 2026"
  readTime="10 min"
  cta={{
    title: "¿Necesitas calcular tu permiso?",
    description: "Usa nuestras herramientas para saber cuánto te corresponden por tus permisos laborales.",
    links: [
      { href: "/calculadoras/nomina/", text: "Calcular mi nómina", primary: true },
      { href: "/calculadoras/pagas-extras/", text: "Calcular pagas extras", primary: false }
    ]
  }}
>
  <Fragment set:html={htmlContent} />
</BlogLayout>
