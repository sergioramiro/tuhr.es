---
import BlogLayout from '../../../layouts/BlogLayout.astro';
import { marked } from 'marked';
import fs from 'fs';
import path from 'path';

const mdPath = path.join(process.cwd(), 'blog-articles', '05-registro-jornada.md');
let md = fs.readFileSync(mdPath, 'utf8');
md = md.replace(/^---[\s\S]*?---/, '').trim();
const htmlContent = marked.parse(md);
---

<BlogLayout
  title="Registro de jornada laboral en España 2026: cómo funciona"
  description="Todo lo que necesitas saber sobre el registro de jornada: qué dice la ley, quién está obligado, sanciones y cómo impugnar."
  category="Normativa"
  date="11 septiembre 2026"
  readTime="10 min"
  cta={{
    title: "¿Te están registrando bien tu jornada?",
    description: "Verifica que tu empresa cumple la ley y conoce tus derechos si no es así.",
    links: [
      { href: "/calculadoras/nomina/", text: "Revisar mi nómina", primary: true },
      { href: "/blog/permisos-laborales/", text: "Conocer tus permisos", primary: false }
    ]
  }}
>
  <Fragment set:html={htmlContent} />
</BlogLayout>
