---
import BlogLayout from '../../../layouts/BlogLayout.astro';
import { marked } from '../../../lib/marked-config';
import fs from 'fs';
import path from 'path';

const mdPath = path.join(process.cwd(), 'blog-articles', '06-vacaciones-derechos.md');
let md = fs.readFileSync(mdPath, 'utf8');
md = md.replace(/^---[\s\S]*?---/, '').trim();
const htmlContent = marked.parse(md);
---

<BlogLayout
  title="Vacaciones laborales en España: tus derechos reales en 2026"
  description="Cuántos días de vacaciones corresponden, cómo se calculan, qué pasa con los festivos y qué hacer si te los niegan."
  category="Derechos"
  date="11 septiembre 2026"
  readTime="10 min"
  cta={{
    title: "Calcula tus pagas extras",
    description: "¿Sabías que las pagas extras también se calculan según tus días trabajados? Descuánto te corresponden.",
    links: [
      { href: "/calculadoras/pagas-extras/", text: "Calcular pagas extras", primary: true },
      { href: "/calculadoras/finiquito/", text: "Incluir vacaciones en finiquito", primary: false }
    ]
  }}
>
  <Fragment set:html={htmlContent} />
</BlogLayout>
