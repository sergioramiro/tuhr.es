---
import BlogLayout from '../../../layouts/BlogLayout.astro';
import { marked } from '../../../lib/marked-config';
import fs from 'fs';
import path from 'path';

const mdPath = path.join(process.cwd(), 'blog-articles', '01-finiquito-errores.md');
let md = fs.readFileSync(mdPath, 'utf8');
md = md.replace(/^---[\s\S]*?---/, '').trim();
const htmlContent = marked.parse(md);
---

<BlogLayout
  title="Cómo calcular tu finiquito: errores comunes que te hacen perder dinero"
  description="Descubre los errores más frecuentes al calcular tu finiquito y cómo evitar que te paguen de menos. Ejemplos reales y consejos prácticos."
  category="Finiquito"
  date="11 septiembre 2026"
  readTime="10 min"
  cta={{
    title: "Calcula tu finiquito ahora",
    description: "Evita errores y descubre cuánto te corresponden realmente con nuestra calculadora gratuita.",
    links: [
      { href: "/calculadoras/finiquito/", text: "Calcular mi finiquito", primary: true },
      { href: "/calculadoras/despido/", text: "Calcular indemnización por despido", primary: false }
    ]
  }}
>
  <Fragment set:html={htmlContent} />
</BlogLayout>
