---
import BlogLayout from '../../../layouts/BlogLayout.astro';
import { marked } from '../../../lib/marked-config';
import fs from 'fs';
import path from 'path';

const mdPath = path.join(process.cwd(), 'blog-articles', '01-finiquito-errores.md');
let md = fs.readFileSync(mdPath, 'utf8');
md = md.replace(/^---[\s\S]*?---/, '').trim();
const htmlContent = marked.parse(md);
---

<BlogLayout
  title="Modelo finiquito laboral: errores comunes | tuhr.es"
  description="Modelo de finiquito laboral: errores más frecuentes al calcular tu finiquito y cómo evitar que te paguen de menos. Consejos prácticos."
  category="Finiquito"
  date="11 septiembre 2026"
  readTime="10 min"
  cta={{
    title: "Calcula tu finiquito ahora",
    description: "Evita errores y descubre cuánto te corresponden realmente con nuestra calculadora gratuita.",
    links: [
      { href: "/calculadoras/finiquito/", text: "Calcular mi finiquito", primary: true },
      { href: "/calculadoras/despido/", text: "Calcular indemnización por despido", primary: false }
    ]
  }}
>
  <Fragment set:html={htmlContent} />

  <!-- CTA: Calculadora relacionada -->
  <div class="mt-space-2xl p-space-lg bg-surface-container-low rounded-xl border border-outline/10">
    <p class="text-body-md text-on-surface/80">
      ¿Quieres evitar estos errores? <a href="/calculadoras/finiquito/" class="text-primary hover:underline font-medium">Calcula tu finiquito con nuestra herramienta gratuita</a> y comprueba que no te están pagando de menos.
    </p>
  </div>
</BlogLayout>
