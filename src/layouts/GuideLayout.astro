---
import Layout from './Layout.astro';

export interface Props {
  title: string;
  description: string;
  ogImage?: string;
  category?: string;
  readTime?: string;
  authorName?: string;
  authorRole?: string;
}

const {
  title,
  description,
  ogImage,
  category = 'Guía Laboral',
  readTime = '5 min de lectura',
  authorName = 'Gabinete Jurídico tuhr.es',
  authorRole = 'Especialistas en Estatuto de los Trabajadores',
} = Astro.props;

const breadcrumbSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://tuhr.es/" },
    { "@type": "ListItem", "position": 2, "name": "Guías", "item": "https://tuhr.es/guias/" },
    { "@type": "ListItem", "position": 3, "name": title.split("|")[0].trim() }
  ]
});
---

<Layout title={title} description={description} ogImage={ogImage}>
  <Fragment slot="json-ld">
    <script type="application/ld+json" set:html={breadcrumbSchema} />
  </Fragment>

  <!-- Reading Progress Bar -->
  <div class="w-full bg-surface-container-low h-1 sticky top-16 z-40">
    <div class="h-full bg-primary transition-all duration-150 w-0" id="read-progress"></div>
  </div>

  <!-- Breadcrumb -->
  <div class="bg-surface-subtle shadow-[0_1px_4px_rgba(0,0,0,0.02)]">
    <div class="max-w-7xl mx-auto px-margin md:px-margin-tablet lg:px-margin-desktop py-space-sm flex items-center gap-space-xs font-caption text-caption text-text-muted overflow-x-auto whitespace-nowrap">
      <a class="hover:text-primary transition-colors flex items-center gap-1" href="/">
        <span class="material-symbols-outlined text-[15px]">home</span>
        <span>Inicio</span>
      </a>
      <span class="material-symbols-outlined text-[14px] text-outline-variant">chevron_right</span>
      <a class="hover:text-primary transition-colors" href="/guias/">Guías</a>
      <span class="material-symbols-outlined text-[14px] text-outline-variant">chevron_right</span>
      <span class="text-primary font-semibold truncate">{title.split("|")[0].trim()}</span>
    </div>
  </div>

  <!-- Hero Section -->
  <section class="w-full bg-surface-subtle py-space-xl md:py-space-2xl">
    <div class="max-w-7xl mx-auto px-margin md:px-margin-tablet lg:px-margin-desktop">
      <div class="max-w-4xl">
        <!-- Category & Badges -->
        <div class="flex flex-wrap items-center gap-space-sm mb-space-md">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-surface-emerald-subtle text-primary font-label-badge text-label-badge tracking-wider uppercase">
            <span class="w-2 h-2 rounded-full bg-brand-emerald-vibrant animate-pulse"></span>
            {category}
          </span>
          <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full bg-surface-container text-on-surface-variant font-caption text-caption">
            <span class="material-symbols-outlined text-[15px]">schedule</span>
            {readTime}
          </span>
          <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full bg-surface-container text-on-surface-variant font-caption text-caption">
            <span class="material-symbols-outlined text-[15px]">verified_user</span>
            Revisión Jurídica tuhr.es
          </span>
        </div>

        <!-- H1 Title -->
        <h1 class="font-headline-h1 text-headline-h1 text-text-primary tracking-tight mb-space-md">
          {title.split("|")[0].trim()}
        </h1>

        <!-- Lead paragraph (slot) -->
        <div class="font-body-lead text-body-lead text-text-secondary mb-space-lg max-w-3xl">
          <slot name="lead" />
        </div>

        <!-- Author Info -->
        <div class="flex items-center gap-space-md pt-space-xs text-text-muted font-caption text-caption">
          <div class="flex items-center gap-2">
            <div class="w-9 h-9 rounded-full bg-primary flex items-center justify-center text-on-primary">
              <span class="material-symbols-outlined text-[18px]">gavel</span>
            </div>
            <div>
              <p class="font-body-bold text-on-surface text-[13px] leading-tight">{authorName}</p>
              <p class="text-text-muted text-[11px]">{authorRole}</p>
            </div>
          </div>
          <span class="text-outline-variant">•</span>
          <span>Vigente normativa 2026</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Two-Column Editorial Layout -->
  <div class="max-w-7xl mx-auto px-margin md:px-margin-tablet lg:px-margin-desktop py-space-2xl w-full">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-space-xl lg:gap-gutter-lg">

      <!-- LEFT SIDEBAR: TOC + Promo Cards -->
      <aside class="lg:col-span-4 order-2 lg:order-1">
        <div class="sticky top-28 space-y-space-lg">

          <!-- TOC Card -->
          <div class="bg-surface-subtle rounded-xl p-space-lg shadow-sm">
            <div class="flex items-center justify-between pb-space-sm mb-space-sm">
              <span class="font-headline-h4 text-headline-h4 text-on-surface flex items-center gap-2">
                <span class="material-symbols-outlined text-primary text-[20px]">list_alt</span>
                Índice de materias
              </span>
            </div>
            <nav class="space-y-1 font-body-small text-body-small text-text-secondary">
              <slot name="toc" />
            </nav>
          </div>

          <!-- Promo Card -->
          <div class="bg-primary rounded-xl p-space-lg text-on-primary shadow-md">
            <div class="flex items-center gap-2 text-primary-fixed mb-space-xs font-caption text-caption font-bold">
              <span class="material-symbols-outlined text-[16px]">verified</span>
              Herramienta oficial tuhr.es
            </div>
            <h3 class="font-headline-h3 text-headline-h3 text-on-primary mb-2">Calculadora Laboral</h3>
            <p class="font-body-small text-body-small text-on-primary-container mb-space-md">
              Genera tu borrador oficial en PDF introduciendo tus datos laborales.
            </p>
            <a class="w-full flex items-center justify-center gap-2 px-space-md py-2.5 rounded-full bg-secondary-container text-on-secondary-fixed font-body-bold text-body-small hover:bg-secondary-fixed transition-colors" href="/calculadoras/">
              <span>Abrir simulador gratuito</span>
              <span class="material-symbols-outlined text-[18px]">launch</span>
            </a>
          </div>

          <!-- Quick Help Card -->
          <div class="bg-surface-container-low rounded-xl p-space-md text-on-surface">
            <div class="flex items-center gap-3">
              <span class="material-symbols-outlined text-primary text-[28px]">support_agent</span>
              <div>
                <p class="font-headline-h4 text-headline-h4 text-text-primary">¿Dudas con tu caso?</p>
                <p class="font-caption text-caption text-text-muted">Revisamos tu situación antes de actuar.</p>
              </div>
            </div>
          </div>
        </div>
      </aside>

      <!-- RIGHT COLUMN: Content -->
      <article class="lg:col-span-8 order-1 lg:order-2 text-text-primary">
        <slot />
      </article>
    </div>
  </div>

  <!-- Scroll Progress Script -->
  <script>
    window.addEventListener('scroll', function() {
      const docHeight = document.documentElement.scrollHeight - document.documentElement.clientHeight;
      const scrolled = (window.scrollY / docHeight) * 100;
      const progressBar = document.getElementById('read-progress');
      if (progressBar) {
        progressBar.style.width = scrolled + '%';
      }
    });
  </script>
</Layout>
